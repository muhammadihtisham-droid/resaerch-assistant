# GEMINI_API_KEY: Optional/legacy API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# XAI_API_KEY: Required for Grok AI calls (xAI API)
XAI_API_KEY="your-xai-api-key-here"

# XAI_MODEL: Configurable Grok model (default: grok-4.6)
XAI_MODEL="grok-4.6"

# GROQ_API_KEY: Required for Groq AI calls (Groq Cloud API)
GROQ_API_KEY="your-groq-api-key-here"

# GROQ_MODEL: Configurable Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

